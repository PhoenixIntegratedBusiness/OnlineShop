@model Domain.ViewModel.ProductViewModel.AllProductDetailviewModel

@{
    ViewData["Title"] = "ProductDetails";
}
<div class="container-fluid" style="padding:8% 8% 1% 8%">
    <div class="row g-4">

        <!-- Product Details -->
        <div class="col-lg-10 product-details">
            <div class="tab-class">
                <div class="row">
                    <div class="col-12">

                        <h4 class="mb-3">
                            @Model.Title Details
                        </h4>

                        <div class="cart-area mb-3" data-product-id="@Model.ProductId">

                            <!-- Add Cart -->
                            <button type="button"
                                    class="btn btn-sm border border-secondary rounded-pill px-5 text-primary add-to-cart">
                                <i class="fa fa-shopping-bag me-1"></i>
                                Add Cart
                            </button>

                            <!-- Quantity -->
                            <div class="quantity-box d-none align-items-center gap-2">

                                <button type="button"
                                        class="btn btn-sm border border-secondary rounded-pill text-primary decrease">
                                    <i class="fa fa-minus"></i>
                                </button>

                                <span class="quantity fw-bold text-dark px-1">1</span>

                                <button type="button"
                                        class="btn btn-sm border border-secondary rounded-pill text-primary increase">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>

                        </div>

                        <hr />

                        <dl class="row">

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.ImageName)
                            </dt>

                           
                            <dd class="col-sm-10">
                                <div class="product-gallery-images">

                                    <!-- Product image -->
                                    <div class="gallery-image main-image">
                                        <img src="/Images/Product/ProductImg/@Model.ImageName"
                                             alt="@Model.Title" />
                                    </div>

                                    <!-- Product Gallery -->
                                    @foreach (var item in Model.ProductGallery)
                                    {
                                        <div class="gallery-image">
                                            <img src="/Images/Product/ProductGallary/@item.ImageName"
                                                 alt="@Model.Title" />
                                        </div>
                                    }
                                </div>
                            </dd>
                            

                            <hr />
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.GroupId)
                            </dt>

                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.GroupId)
                            </dd>


                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Title)
                            </dt>

                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Title)
                            </dd>


                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Price)
                            </dt>

                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Price)
                            </dd>


                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Summery)
                            </dt>

                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Summery)
                            </dd>


                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Description)
                            </dt>

                            <dd class="col-sm-10">
                                @Html.Raw(Model.Description)
                            </dd>

                        </dl>

                        <!-- Tags -->
                        <hr />
                        <h3>@Model.Title  Tags:</h3>
                        <div class="mt-4">

                            @foreach (var item in Model.Tags)
                            {
                                <a asp-controller="Product" asp-action="SearchProductKey" asp-route-q="@item.TagName" class="product-tag">
                                    <i class="fa fa-tag me-1"></i>
                                    @item.TagName
                                </a>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>


        <!-- Sidebar -->
        <div class="col-lg-2">

            <div class="sidebar-box mb-4">

                <h6 class="mb-3" style="color:#81C408">
                    Product Categories
                </h6>

                @await Component.InvokeAsync("ProductGroup")

            </div>

            <!-- Cart -->
            @await Component.InvokeAsync("ShopCart")

        </div>

    </div>
</div>















