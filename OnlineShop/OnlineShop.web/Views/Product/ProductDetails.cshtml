@model Domain.ViewModel.ProductViewModel.AllProductDetailviewModel

@{
    ViewData["Title"] = "ProductDetails";
}


<div class="container  py-5" style="margin-top:5%">
    <div class="tab-class">
       
        <div class="row">
            <div class="col-md-10">
                <div class="tab-content col-lg-12">

                    <div>
                        <div class="row">
                            <div>
                                <h4>@Model.Title Details</h4>
                            </div>
                            <div >
                                <div class="cart-area" data-product-id="@Model.ProductId">

                                    <!-- Add Cart -->
                                    <button type="button"
                                            class="btn btn-sm border border-secondary rounded-pill px-5 text-primary add-to-cart">
                                        <i class="fa fa-shopping-bag me-1"></i>
                                        Add Cart
                                    </button>

                                    <!-- Quantity -->
                                    <div class="quantity-box d-none align-items-center gap-2">

                                        <button type="button"
                                                class="btn btn-sm border border-secondary rounded-pill text-primary decrease">
                                            <i class="fa fa-minus"></i>
                                        </button>

                                        <span class="quantity fw-bold text-dark px-1">1</span>

                                        <button type="button"
                                                class="btn btn-sm border border-secondary rounded-pill text-primary increase">
                                            <i class="fa fa-plus"></i>
                                        </button>

                                    </div>

                                </div>

                            </div>
                        </div>

                      
                        <hr />
                        <dl class="row">

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.ImageName)
                            </dt>
                            <dd class="col-sm-10">
                                <img src="/Images/Product/ProductImg/@Model.ImageName" class="img-thumb100 img-thumbnail"/>
                            </dd>

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.GroupId)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.GroupId)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Title)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Title)
                            </dd>
                          
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Price)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Price)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Summery)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Summery)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Description)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.Raw(Model.Description)
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

       @*      <div class="col-md-4 col-sm-12 col-xs-12 pull-right product-gallery">
                <div class="large-image border-radius">
                    <img class="border-radius" src="/Images/@Model.ProductImages.FirstOrDefault()?.ImageName">
                </div>
                <div class="thumbnails-image">
                    <div class="row">
                        @foreach (var item in Model.ProductImages)
                        {
                            <div class="col-md-3 col-sm-3 col-xs-4 border-radius"><img class="border-radius" src="/Images/@item.ImageName"></div>

                        }
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div> *@


            <div class="col-md-2">
                <div class="sidebar-box mb-4">
                    <h6 class="mb-3" style="color:#81C408">Product Categories</h6>
                    @await Component.InvokeAsync("ProductGroup")
                </div>

                <!-- Cart -->
                @await Component.InvokeAsync("ShopCart")
            </div>
        </div>
    </div>
</div>















