@using Domain.ViewModel.AccountViewModel
@model ResetPasswordViewModel


<section class="border-radius mb-4">

    <article>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-sm-8 col-12">
                    <div class="text-center mb-4" style="margin-top:17%">
                        <h3>Reset Password Page</h3>
                    </div>
                    <form asp-action="ResetPassword" asp-controller="Account" method="post">

                        <div class="form-group mb-4">
                            <input asp-for="Email" class="form-control" placeholder="Email">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="ActiveCode" class="form-control" placeholder="ActiveCode">
                            <span asp-validation-for="ActiveCode" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="Password" class="form-control" placeholder=" New Password">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="RePassword" class="form-control" placeholder="Re-Enter New Password">
                            <span asp-validation-for="RePassword" class="text-danger"></span>
                        </div>

                        <br />
                        <input type="submit" value="submit" class="btn btn-success mb-4">

                    </form>

                </div>
            </div>
        </div>
    </article>
</section>