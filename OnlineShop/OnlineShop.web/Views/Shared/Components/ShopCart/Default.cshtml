@using Domain.Model
@model Order

<div class="sidebar-box">

    <h6 class="mb-3" style="color:#81C408">Shopping Cart</h6>

    <div class="cart-items">
        @foreach (var item in Model.OrderDetails ?? new List<OrderDetail>())
        {
            <div class="cart-item d-flex align-items-center mb-3">
                <img src="/Images/Product/ProductImg/@item.Product.ImageName"
                     class="rounded"
                     width="55"
                     height="55">

                <div class="ms-2">
                    <h6 class="mb-1">@item.Product.Title</h6>
                    <small>Count: @item.Count *</small>
                    <small>Price: @item.Product.Price</small>
                </div>
            </div>

            <hr>
        }
    </div>

    <a href="/ShowShopCart"
       class="btn btn-primary rounded-pill w-100 mt-3">
        View Cart Details
    </a>

</div>