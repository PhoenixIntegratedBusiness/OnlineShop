@using Domain.ViewModel.AccountViewModel
@model ChangePasswordViewModel

<section class="border-radius mb-4">

    <article>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-sm-8 col-12">
                    <div class="text-center mb-4" style="margin-top:17%">
                        <h3>Change Password</h3>
                    </div>
                    <form asp-action="ChangePassword" asp-controller="User" asp-area="UserPanel" method="post">
                       

                        <div class="form-group mb-4">
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter Your Current Password">
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="NewPassword" class="form-control" placeholder="Enter Your New Password">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <input asp-for="ReNewPassword" class="form-control" placeholder="ReEnter Your New Password">
                            <span asp-validation-for="ReNewPassword" class="text-danger"></span>
                        </div>

                    
                        <br />

                        <input type="submit" value="submit" class="btn btn-success mb-4">
                    </form>


                </div>
            </div>
        </div>
    </article>
</section>