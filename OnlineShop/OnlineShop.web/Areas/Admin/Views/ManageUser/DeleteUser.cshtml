@model Domain.ViewModel.AccountViewModel.DeleteUserViewModel


<h1>Delete User</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Delete User</h4>
    <hr />
    <dl class="row">
      
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Username)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Username)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mobile)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Mobile)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsAdmin)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsAdmin)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreateDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreateDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.isDelete)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.isDelete)
        </dd>

        <dt class="col-sm-2">
              Role Name
        </dt>
        <dd class="col-sm-10">
      
            @string.Join(", ",Model.SelectedRoleNames)
        </dd>
          
    </dl>

    <form asp-action="DeleteUserConfirmed" asp-controller="ManageUser" method="post">
        <input type="hidden" asp-for="UserId" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        <a asp-action="UserList"asp-controller="ManageUser" class="btn btn-info">
            Back to List
        </a>
    </form>
</div>
