@model Domain.ViewModel.ProductViewModel.EditProductviewModel

@{
    ViewData["Title"] = "EditProduct";
    Layout = "~/Areas/Admin/Views/Shared/_AdminPanelLayout.cshtml";
}

<h1>EditProduct</h1>
<section class="border-radius mb-4">
    <article>
        <div class="container">
            <div class="row ">
                <div class="col-md-9 col-sm-8 col-12">
                    <div class="text-center mb-4" style="margin-top:17%">
                        <h3>Edit Product</h3>
                    </div>
                    <form asp-action="EditProduct" asp-controller="Product" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="CreateDate" />
                        <input type="hidden" asp-for="ImageName" />

                        <div class="form-group">
                            <label asp-for="GroupId" class="control-label"></label>
                            <select asp-for="GroupId" class="form-control" asp-items="@(ViewBag.GroupId)">
                            </select>
                            <span asp-validation-for="GroupId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Title" class="control-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ImageName" class="control-label"></label>
                            <img src="/Images/Product/ProductImg/@Model.ImageName" style="width:150px;height:150px" id="impPrev" />
                            <input type="file" name="ImgUpload" onchange="ShowPreview(this)" value="nophoto.png" multiple="false" />
                            <span asp-validation-for="ImageName" class="text-danger"></span>
                        </div>


                        <div class="form-group">
                            <label asp-for="Price" class="control-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Summery" class="control-label"></label>
                            <textarea asp-for="Summery" class="form-control"></textarea>
                            <span asp-validation-for="Summery" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description" class="control-label"></label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                          <div class="form-group">
                            <label asp-for="Tags" class="control-label"></label>
                            @{
                                var keywords = Model.Tags != null ? string.Join(",", Model.Tags.Select(x => x.TagName)) : "";
                            }
                            <textarea name="TagsText" class="form-control" rows="3">@keywords</textarea>
                            <span asp-validation-for="Tags" class="text-danger"></span>
                        </div>

                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" asp-for="isDelete" />
                                @Html.DisplayNameFor(model => model.isDelete)
                            </label>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Product Gallery Photos</label>
                            @{
                                if (Model.ProductGallery != null)
                                {
                                    <div class="row">
                                        @foreach (var img in Model.ProductGallery)
                                        {
                                            <div id="img_@(img.GalleryID)" class="img-thumbnail col-md-4">
                                                <img src="/Images/Product/ProductGallary/@img.ImageName" style="width:100%;height:250px" />
                                                <a onclick="deleteImg(@img.GalleryID)"
                                                   class="btn btn-danger btn-block btn-sm" style="margin-top:5px">حذف</a>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            <div style="margin: 5px 5px 5px 5px;">
                                <input type="file" name="Gimgupload" multiple="true" id="fileupload" /><br />
                                <div id="dvPreview"></div>
                            </div>
                        </div>


                        <div class="form-group">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </article>
</section>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        //       $(document).ready(function () {
        //     alert("JS OK");
        // });

        function deleteImg(id) {
            alert("ID = " + id);

            $.get("/Admin/Product/DeleteProductGallary/" + id)
                .done(function () {
                    $("#img_" + id).hide(1000);
                })
                .fail(function (xhr) {
                    console.log(xhr.status);
                });
        }

    </script>
}

